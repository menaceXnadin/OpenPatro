<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenPatro</RootNamespace>
    <!-- Default to x64 when no platform is specified (e.g. plain 'dotnet build') -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Use our own Program.cs entry point so we can enforce single-instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The test project lives under tests/; keep its sources out of the app build. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <Page Remove="tests\**" />
    <InternalsVisibleTo Include="OpenPatro.Tests" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" />
    <!-- Pin the native SQLite bundle above 2.1.11 (GHSA-2m69-gcr7-jv3q, High: affects <= 2.1.11). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Formats.Nrbf" Version="9.0.1" />
    <!-- Managed projections of unused Windows App SDK components (see ExcludeUnusedWindowsAppSdkPayload). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.47" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2124" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Data\calendar.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\NotoSansDevanagari.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" Condition="Exists('.github\copilot-instructions.md')" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include=".github\workflows\" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Never trim. WinUI hands .NET collections (ObservableCollection etc.) to XAML via
         CsWinRT, which needs interop code the trimmer removes: every ItemsSource binding then
         throws NullReferenceException in WinRT.TypeExtensions.GetAbiToProjectionVftblPtr
         (seen in 1.0.0-era logs and again in a 1.0.2 test build). Trimming would require the
         CsWinRT AOT source generators and [GeneratedBindableCustomProperty] on every bound type. -->
    <PublishTrimmed>False</PublishTrimmed>
    <!-- NU1603: the AI/ML component packages (referenced only to exclude them) ask for an
         older Foundation build than the one the metapackage already resolves. Harmless. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Self-contained Windows App SDK deployment copies the whole runtime, including AI/ML
    (ONNX Runtime, DirectML) and Widgets, ~42 MB that OpenPatro never loads. The SDK's own
    MicrosoftWindowsAppSDKFilesExcluded hook removes them from the copy list. If the app
    ever starts using Windows AI/Widgets APIs, delete this target and the three references below.
  -->
  <Target Name="ExcludeUnusedWindowsAppSdkPayload"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix;AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup Condition="'$(MicrosoftWindowsAppSDKMsixContent)' != ''">
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.AI.*" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Widgets.*" />
    </ItemGroup>
  </Target>

  <!-- VS deploy expects AppxManifest.xml at the output root for packaged launches. -->
  <Target Name="EnsureRootAppxManifestForDeploy" AfterTargets="Build" Condition="'$(EnableMsixTooling)'=='true'">
    <PropertyGroup>
      <_GeneratedAppxManifest>$(TargetDir)AppX\AppxManifest.xml</_GeneratedAppxManifest>
      <_DeployExpectedAppxManifest>$(TargetDir)AppxManifest.xml</_DeployExpectedAppxManifest>
    </PropertyGroup>
    <Copy SourceFiles="$(_GeneratedAppxManifest)" DestinationFiles="$(_DeployExpectedAppxManifest)" SkipUnchangedFiles="true" Condition="Exists('$(_GeneratedAppxManifest)')" />
  </Target>
</Project>